{
    "name": "perroblanco0/michi-arena",
    "description": "Michi Arena: duelos de cartas de gatos virales y apuestas de Aura con CodeIgniter 4",
    "license": "MIT",
    "type": "project",
    "homepage": "https://github.com/perroBlanco0/aura-duelos-meme",
    "require": {
        "php": "^8.2",
        "codeigniter4/framework": "^4.7.4"
    },
    "require-dev": {
        "fakerphp/faker": "^1.9",
        "mikey179/vfsstream": "^1.6",
        "phpunit/phpunit": "^10.5.16"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Config\\": "app/Config/"
        },
        "exclude-from-classmap": [
            "**/Database/Migrations/**"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\Support\\": "tests/_support"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit"
    },
    "authors": [
        {
            "name": "perroBlanco0",
            "homepage": "https://github.com/perroBlanco0"
        }
    ]
}
